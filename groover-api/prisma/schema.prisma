// prisma/schema.prisma
// Groover - 쇼핑 커뮤니티 플랫폼

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  ADVERTISER
  ADMIN
  SUPER_ADMIN
}

// ==================== USER ====================
model User {
  id              String    @id @default(uuid())
  userId          String?   @unique @map("user_id")
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String?
  profileImageUrl String?   @map("profile_image_url")
  bio             String?   // 자기소개
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  warningCount    Int       @default(0)
  suspendedUntil  DateTime?
  role            Role      @default(USER)
  googleId        String?   @unique
  isProfilePublic Boolean   @default(true)
  isVerified      Boolean   @default(false)

  // 관계
  posts             Post[]
  postLikes         PostLike[]
  postShares        PostShare[]
  comments          Comment[]
postHistories UserPostHistory[]
  
  // 태그 시스템
  pinnedTags        UserPinnedTag[]
  
  // 토론
  discussions       Discussion[]
  discussionComments DiscussionComment[]
  discussionVotes   DiscussionVote[]

  // 팔로우
  followers         Follow[] @relation("Following")
  following         Follow[] @relation("Followers")

  // DM
  dmThreadsAsUser1  DmThread[]  @relation("DmThreadUser1")
  dmThreadsAsUser2  DmThread[]  @relation("DmThreadUser2")
  dmMessages        DmMessage[]
  dmBlocksMade      DmBlock[]   @relation("DmBlocker")
  dmBlocksReceived  DmBlock[]   @relation("DmBlocked")
  dmReportsMade     DmReport[]  @relation("DmReporter")
  dmReportsReceived DmReport[]  @relation("DmReported")

  // 알림
  notifications     Notification[]
  pushTokens        PushToken[]
  fcmTokens         FcmToken[]

  // 기타
  searchHistories   SearchHistory[]
  refreshTokens     RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  warnings          UserWarning[]
  eventLogs         EventLog[]
  adminActions      AdminActionLog[] @relation("AdminActions")

  @@map("users")
}

// ==================== FOLLOW ====================
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ==================== TAG SYSTEM ====================

// 피드용 태그 (Controlled) - 관리자/시스템이 생성
model FeedTag {
  id          String   @id @default(uuid())
  name        String   @unique  // 정규화된 이름 (노트북, 러닝화 등)
  slug        String   @unique  // URL용 (notebook, running-shoes)
  category    String?  // 상위 카테고리 (전자기기, 패션 등)
  description String?
  iconEmoji   String?  // 아이콘 이모지
  postCount   Int      @default(0)  // 이 태그 사용한 글 수
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  posts       PostFeedTag[]
  pinnedBy    UserPinnedTag[]
  mappings    TagMapping[]
  discussions Discussion[]

  @@index([category])
  @@index([postCount])
}

// 검색용 태그 (Freeform) - 누구나 생성 가능
model FreeTag {
  id        String   @id @default(uuid())
  name      String   @unique  // 원본 그대로 (갤탭s9울트라, 내돈내산 등)
  useCount  Int      @default(0)  // 사용 횟수
  createdAt DateTime @default(now())

  // 관계
  posts     PostFreeTag[]
  mappings  TagMapping[]

  @@index([useCount])
}

// 검색태그 → 피드태그 매핑
model TagMapping {
  id         String   @id @default(uuid())
  freeTagId  String
  freeTag    FreeTag  @relation(fields: [freeTagId], references: [id], onDelete: Cascade)
  feedTagId  String
  feedTag    FeedTag  @relation(fields: [feedTagId], references: [id], onDelete: Cascade)
  confidence Float    @default(1.0)  // 매핑 신뢰도 (0~1)
  createdAt  DateTime @default(now())

  @@unique([freeTagId, feedTagId])
  @@index([freeTagId])
  @@index([feedTagId])
}

// 유저가 핀한 피드태그
model UserPinnedTag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedTagId String
  feedTag   FeedTag  @relation(fields: [feedTagId], references: [id], onDelete: Cascade)
  order     Int      @default(0)  // 정렬 순서
  createdAt DateTime @default(now())

  @@unique([userId, feedTagId])
  @@index([userId])
}

// ==================== POST ====================
model Post {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  content       String
  previewImage  String?
  
  // 기존 태그 (하위호환)
  tags          String[]

  // SEO
  slug          String    @unique
  excerpt       String?

  // 통계
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  shareCount    Int       @default(0)
  commentCount  Int       @default(0)

  // 상태
  status        String    @default("DRAFT")  // DRAFT, PUBLISHED, HIDDEN
  publishedAt   DateTime?

  // 관계
  feedTags      PostFeedTag[]
  freeTags      PostFreeTag[]
  likes         PostLike[]
  shares        PostShare[]
  comments      Comment[]
viewHistories UserPostHistory[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
}
model UserPostHistory {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  viewedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}
// Post-FeedTag 연결 테이블
model PostFeedTag {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  feedTagId String
  feedTag   FeedTag  @relation(fields: [feedTagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, feedTagId])
  @@index([postId])
  @@index([feedTagId])
}

// Post-FreeTag 연결 테이블
model PostFreeTag {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  freeTagId String
  freeTag   FreeTag  @relation(fields: [freeTagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, freeTagId])
  @@index([postId])
  @@index([freeTagId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  platform  String?
  createdAt DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
}

// ==================== COMMENT ====================
model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content   String
  parentId  String?  // 대댓글용
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

// ==================== DISCUSSION (토론방) ====================
model Discussion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  content     String
  
  // 연결된 피드태그
  feedTagId   String?
  feedTag     FeedTag? @relation(fields: [feedTagId], references: [id], onDelete: SetNull)
  
  // 투표 옵션 (선택)
  hasVote     Boolean  @default(false)
  voteOptions Json?    // ["옵션1", "옵션2", ...]
  
  // 통계
  viewCount   Int      @default(0)
  commentCount Int     @default(0)
  voteCount   Int      @default(0)
  
  // 상태
  status      String   @default("ACTIVE")  // ACTIVE, CLOSED, HIDDEN
  closedAt    DateTime?
  
  // 관계
  comments    DiscussionComment[]
  votes       DiscussionVote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([feedTagId])
  @@index([status])
  @@index([createdAt])
}

model DiscussionComment {
  id           String     @id @default(uuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content      String
  parentId     String?
  parent       DiscussionComment?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      DiscussionComment[] @relation("DiscussionReplies")
  
  likeCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([discussionId])
  @@index([userId])
  @@index([parentId])
}

model DiscussionVote {
  id           String     @id @default(uuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  optionIndex  Int        // 투표한 옵션 인덱스
  createdAt    DateTime   @default(now())

  @@unique([discussionId, userId])  // 한 유저 한 토론에 한 표
  @@index([discussionId])
}

// ==================== DM ====================
model DmThread {
  id              String    @id @default(uuid())
  user1Id         String
  user1           User      @relation("DmThreadUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id         String
  user2           User      @relation("DmThreadUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  lastMessage     String?
  lastMessageAt   DateTime?
  unreadCountUser1 Int      @default(0)
  unreadCountUser2 Int      @default(0)

  messages        DmMessage[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
}

model DmMessage {
  id          String    @id @default(uuid())
  threadId    String
  thread      DmThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content     String
  messageType String    @default("text")
  metadata    Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  reports     DmReport[]

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model DmBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("DmBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("DmBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model DmReport {
  id         String     @id @default(uuid())
  reporterId String
  reporter   User       @relation("DmReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User       @relation("DmReported", fields: [reportedId], references: [id], onDelete: Cascade)
  messageId  String?
  message    DmMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reason     String
  status     String     @default("PENDING")
  createdAt  DateTime   @default(now())
  reviewedAt DateTime?

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

// ==================== NOTIFICATION ====================
enum NotificationType {
  NEW_FOLLOWER
  POST_LIKED
  POST_COMMENTED
  DISCUSSION_REPLY
  NEW_MESSAGE
  TAG_NEW_POST
  SYSTEM_NOTICE
  WARNING_RECEIVED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  targetType String?
  targetId   String?
  metadata   Json?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  device    String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

// ==================== AUTH ====================
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  email     String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ==================== SEARCH ====================
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  type      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([query])
}

model PopularSearch {
  id        String   @id @default(cuid())
  query     String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count(sort: Desc)])
}

// ==================== LOGGING ====================
model EventLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  targetId  String?
  keyword   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([createdAt])
}

model UserWarning {
  id        String      @id @default(cuid())
  userId    String
  type      WarningType
  reason    String
  count     Int         @default(1)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum WarningType {
  SPAM
  ABUSE
  SCAM
  OTHER
}

model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActions", fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  beforeData Json?
  afterData  Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

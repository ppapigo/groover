// ============================================
// 직거래 방지 시스템
// ============================================

// 직거래 시도 로그
model DirectTradeAttempt {
  id               String   @id @default(cuid())
  userId           String
  threadId         String?
  originalContent  String   @db.Text
  detectedPatterns Json     // 감지된 패턴들
  detectedTypes    Json     // 감지된 타입들 (BANK_ACCOUNT, PHONE_NUMBER 등)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// 유저 경고 기록
model UserWarning {
  id        String      @id @default(cuid())
  userId    String
  type      WarningType
  reason    String
  count     Int         @default(1)  // 누적 경고 횟수
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum WarningType {
  DIRECT_TRADE_ATTEMPT  // 직거래 시도
  SPAM                  // 스팸
  ABUSE                 // 욕설/혐오
  SCAM                  // 사기
  OTHER                 // 기타
}

